# Optional override. If blank, a random local secret is persisted beside the database.
JWT_SECRET=
# Optional database location. Defaults to backend/mediassist.db.
# MEDIASSIST_DB=/absolute/path/mediassist.db
# Optional local Tesseract executable for PNG/JPEG OCR:
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Optional loopback-only Ollama extraction; disabled by default:
OLLAMA_ENABLED=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# All external notifications remain disabled unless explicitly configured.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=
# Only registered public greetings may use optional loopback translation:
OLLAMA_TRANSLATION_ENABLED=0

# Optional locally generated condition hypotheses stay held for a doctor:
OLLAMA_ASSESSMENT_ENABLED=0
